external/paper-qa/**/.idea/**/tasks.xml
external/paper-qa/**/.idea/**/usage.statistics.xml
external/paper-qa/**/.idea/**/dictionaries
external/paper-qa/**/.idea/**/shelf

# AWS User-specific
external/paper-qa/**/.idea/**/aws.xml

# Generated files
external/paper-qa/**/.idea/**/contentModel.xml

# Sensitive or high-churn files
external/paper-qa/**/.idea/**/dataSources
external/paper-qa/**/.idea/**/dataSources.ids
external/paper-qa/**/.idea/**/dataSources.local.xml
external/paper-qa/**/.idea/**/sqlDataSources.xml
