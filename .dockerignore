# flyctl launch added from .beads/.gitignore
# SQLite databases
.beads/**/*.db
.beads/**/*.db?*
.beads/**/*.db-journal
.beads/**/*.db-wal
.beads/**/*.db-shm

# Daemon runtime files
.beads/**/daemon.lock
.beads/**/daemon.log
.beads/**/daemon.pid
.beads/**/bd.sock
.beads/**/sync-state.json
.beads/**/last-touched

# Local version tracking (prevents upgrade notification spam after git ops)
.beads/**/.local_version

# Legacy database files
.beads/**/db.sqlite
.beads/**/bd.db

# Worktree redirect file (contains relative path to main repo's .beads/)
# Must not be committed as paths would be wrong in other clones
.beads/**/redirect

# Merge artifacts (temporary files from 3-way merge)
.beads/**/beads.base.jsonl
.beads/**/beads.base.meta.json
.beads/**/beads.left.jsonl
.beads/**/beads.left.meta.json
.beads/**/beads.right.jsonl
.beads/**/beads.right.meta.json

# NOTE: Do NOT add negation patterns (e.g., !issues.jsonl) here.
# They would override fork protection in .git/info/exclude, allowing
# contributors to accidentally commit upstream issue databases.
# The JSONL files (issues.jsonl, interactions.jsonl) and config files
# are tracked by git by default since no pattern above ignores them.

# flyctl launch added from .gitignore
# Python
**/__pycache__
**/*.py[cod]
**/*$py.class
**/*.so
**/.Python
**/build
**/develop-eggs
**/dist
**/downloads
**/eggs
**/.eggs
**/lib
**/lib64
**/parts
**/sdist
**/var
**/wheels
**/*.egg-info
**/.installed.cfg
**/*.egg

# Virtual environments
**/.env
**/.venv
**/venv
**/ENV

# IDE
**/.idea
**/.vscode
**/*.swp
**/*.swo

# Data (local development)
**/data

# External dependencies (if cloned locally)
**/external

# flyctl launch added from .venv/.gitignore
.venv/**/*

# flyctl launch added from .venv/lib/python3.13/site-packages/litellm/proxy/.gitignore
.venv/lib/python3.13/site-packages/litellm/proxy/**/.env
.venv/lib/python3.13/site-packages/litellm/proxy/**/secrets.toml

# flyctl launch added from external/paper-qa/.gitignore
# Swap
external/paper-qa/**/[._]*.s[a-v][a-z]
!external/paper-qa/**/*.svg  # comment out if you don't need vector files
external/paper-qa/**/[._]*.sw[a-p]
external/paper-qa/**/[._]s[a-rt-v][a-z]
external/paper-qa/**/[._]ss[a-gi-z]
external/paper-qa/**/[._]sw[a-p]

# Session
external/paper-qa/**/Session.vim
external/paper-qa/**/Sessionx.vim

# Temporary
external/paper-qa/**/.netrwhist
external/paper-qa/**/*~
# Auto-generated tag files
external/paper-qa/**/tags
# Persistent undo
external/paper-qa/**/[._]*.un~
# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio, WebStorm and Rider
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# User-specific stuff
