# ===========================================
# ArxivBot Configuration
# ===========================================

# Gemini API key (get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the primary chat model (default: gemini/gemini-3.8-flash)
# LLM_MODEL=gemini/gemini-3.8-flash

# Optional: comma-separated free-tier fallbacks tried in order; "" disables them
# LLM_FREE_FALLBACK_MODELS=gemini/gemini-3.7-flash,gemini/gemini-3.5-flash-lite

# Optional: paid key, used last with LLM_FALLBACK_MODEL
# GEMINI_API_KEY_PAID=
# LLM_FALLBACK_MODEL=gemini/gemini-2.5-flash-lite

# SQLite database path
DATABASE_PATH=./data/arxivbot.db
